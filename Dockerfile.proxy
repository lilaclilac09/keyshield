# KeyShield Rust proxy — ks-proxy binary
#
# Built from src/proxy/ workspace. The compose file sets the build
# context to ./src/proxy and references this dockerfile via
# `dockerfile: ../Dockerfile.proxy`, so the build context here is the
# proxy workspace root, NOT the repo root.

# ─── Builder ────────────────────────────────────────────────────────
FROM rust:1.94-slim-bookworm AS builder

# Build deps for `bundled` rusqlite + rustls
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the workspace
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

# Build only the binary we ship
RUN cargo build --release -p ks-proxy

# ─── Runtime ────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -g nogroup keyshield

COPY --from=builder /build/target/release/ks-proxy /usr/local/bin/ks-proxy

USER keyshield
EXPOSE 3000

ENV PROXY_PORT=3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O- "http://localhost:${PROXY_PORT}/health" >/dev/null || exit 1

CMD ["ks-proxy"]
