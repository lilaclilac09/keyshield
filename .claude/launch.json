{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "python-backend",
      "runtimeExecutable": "v2-mvp/.venv/bin/uvicorn",
      "runtimeArgs": [
        "--app-dir",
        "v2-mvp",
        "src.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "rust-proxy",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "--manifest-path",
        "proxy-rs/Cargo.toml",
        "--bin",
        "ks-proxy"
      ],
      "port": 8000
    },
    {
      "name": "frontend-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "5173"
      ],
      "port": 5173
    }
  ]
}
