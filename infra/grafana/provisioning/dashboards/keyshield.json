{
  "title": "KeyShield",
  "uid": "keyshield-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Proxy Requests / sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(ks_proxy_requests_total[1m])) by (upstream)",
        "legendFormat": "{{upstream}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "Proxy P95 Latency (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(ks_proxy_latency_seconds_bucket[5m])) by (le, upstream))",
        "legendFormat": "p95 {{upstream}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "Error Rate (4xx+5xx)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [{
        "expr": "sum(rate(ks_proxy_requests_total{status_code=~\"4..|5..\"}[1m]))",
        "legendFormat": "errors/s"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 4,
      "title": "Auth Attempts",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        { "expr": "rate(ks_auth_attempts_total{result=\"success\"}[1m])", "legendFormat": "success" },
        { "expr": "rate(ks_auth_attempts_total{result=\"failure\"}[1m])", "legendFormat": "failure" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 5,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "ks_active_sessions", "legendFormat": "sessions" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [
        { "color": "green", "value": 0 },
        { "color": "yellow", "value": 50 },
        { "color": "red", "value": 200 }
      ]}}}
    },
    {
      "id": 6,
      "title": "Billing Top-ups (USD)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "increase(ks_billing_topup_usd_total[10m])",
        "legendFormat": "USD topped up (10m)"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 7,
      "title": "Vault Ops / sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(ks_vault_ops_total[1m])) by (op)",
        "legendFormat": "{{op}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
