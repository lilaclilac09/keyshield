# KeyShield React frontend (web-v2) — multi-stage Vite + nginx build.
#
# Layout note: docker-compose.yml sets `context: ./src/web-v2` and
# `dockerfile: ../../Dockerfile.web`, so paths in this file are
# relative to the src/web-v2/ directory.

# ─── Builder ────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

# Cache deps before source changes.
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# Build-time env (compose passes these through `args`):
ARG KEYSHIELD_API_URL=http://localhost:8000
ARG KEYSHIELD_PROGRAM_ID=41P2wHKAr69aSgLgt1QdKH6VVgK6uFYKM7hpKAyBxr9j
ARG KEYSHIELD_SOLANA_CLUSTER=devnet
ARG KEYSHIELD_SYNC_URL=http://localhost:8787
ENV KEYSHIELD_API_URL=$KEYSHIELD_API_URL \
    KEYSHIELD_PROGRAM_ID=$KEYSHIELD_PROGRAM_ID \
    KEYSHIELD_SOLANA_CLUSTER=$KEYSHIELD_SOLANA_CLUSTER \
    KEYSHIELD_SYNC_URL=$KEYSHIELD_SYNC_URL

COPY . .
RUN npm run build

# ─── Runtime ────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Replace default config with SPA-friendly fallback so deep links work
# and the listen port matches docker-compose's `3001:3000` mapping.
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:3000/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
