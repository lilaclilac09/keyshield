# KeyShield Docker convenience targets.
#
# This file is separate from the top-level Makefile so it doesn't fight
# with non-Docker workflows. Common commands:
#
#   make -f Makefile.docker build       — build all images
#   make -f Makefile.docker up          — start the 5-service stack
#   make -f Makefile.docker up-obs      — also start prometheus + grafana
#   make -f Makefile.docker logs        — tail logs (Ctrl+C to detach)
#   make -f Makefile.docker logs-py     — tail just the python backend
#   make -f Makefile.docker ps          — show service health
#   make -f Makefile.docker down        — stop, keep volumes
#   make -f Makefile.docker down-clean  — stop + drop named volumes
#   make -f Makefile.docker rebuild     — no-cache rebuild + restart
#   make -f Makefile.docker shell-py    — exec bash in python container
#   make -f Makefile.docker smoke       — run scripts/smoke.sh against the stack

COMPOSE := docker compose
ENV     := --env-file .env

.PHONY: help build up up-obs logs logs-py logs-rust logs-web ps down down-clean rebuild shell-py shell-rust smoke

help:
	@grep -E '^[a-zA-Z_-]+:.*?##' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?##"}{printf "  %-14s %s\n", $$1, $$2}'

build:  ## Build all 3 KeyShield images (python, rust-proxy, frontend)
	$(COMPOSE) $(ENV) build

up:  ## Start the 5-service stack in the background
	$(COMPOSE) $(ENV) up -d
	@echo ""
	@echo "  python:    http://localhost:8000/health"
	@echo "  rust-proxy http://localhost:3000/health"
	@echo "  frontend:  http://localhost:3001"
	@echo "  postgres:  localhost:5432 (keyshield/keyshield)"
	@echo "  redis:     localhost:6379"
	@echo ""

up-obs:  ## Start stack + observability (prometheus 9090 + grafana 3001)
	$(COMPOSE) $(ENV) -f docker-compose.yml -f docker-compose.observability.yml up -d
	@echo "  prometheus http://localhost:9090"
	@echo "  grafana    http://localhost:3001  (admin/admin)"
	@echo "  NOTE: observability stack uses port 3001 — frontend will conflict."
	@echo "        Stop frontend first or remap one of them."

logs:     ## Tail all logs
	$(COMPOSE) logs -f

logs-py:  ## Tail just the python backend
	$(COMPOSE) logs -f python

logs-rust: ## Tail just the rust proxy
	$(COMPOSE) logs -f rust-proxy

logs-web: ## Tail just the frontend
	$(COMPOSE) logs -f frontend

ps:  ## Show service health status
	$(COMPOSE) ps

down:  ## Stop containers, keep named volumes (postgres + redis data)
	$(COMPOSE) down

down-clean:  ## Stop + drop volumes (DESTRUCTIVE — wipes postgres + redis + vault)
	$(COMPOSE) down -v

rebuild:  ## Rebuild images from scratch (no cache)
	$(COMPOSE) $(ENV) build --no-cache
	$(COMPOSE) $(ENV) up -d

shell-py:  ## Exec bash inside the python backend
	$(COMPOSE) exec python /bin/bash || $(COMPOSE) exec python /bin/sh

shell-rust:  ## Exec sh inside the rust proxy
	$(COMPOSE) exec rust-proxy /bin/sh

smoke:  ## Run smoke.sh against the running stack
	@KS_API_URL=http://localhost:8000 bash scripts/smoke.sh
