    "provider": {
      "role": "MPP settler / platform USDC receiver",
      "env": "KS_PROVIDER_WALLET",
      "defaultPath": ".keyshield-devnet/mpp-settler-devnet.json"
    }
  },
  "inference": {
    "openrouter": {
      "base": "https://openrouter.ai",
      "proxyPath": "/proxy/openrouter/api/v1/chat/completions",
      "defaultModel": "meta-llama/llama-3.2-3b-instruct:free"
    },
    "ollama": {
      "base": "http://127.0.0.1:11434",
      "proxyPath": "/proxy/ollama/v1/chat/completions",
      "defaultModel": "llama3.2"
    },
    "vllm": {
      "base": "http://127.0.0.1:8000",
      "proxyPath": "/proxy/vllm/v1/chat/completions",
      "defaultModel": "Qwen/Qwen2.5-7B-Instruct"
    }
  },
  "note": "Metadata only. Keypair JSON files are never committed."
}
