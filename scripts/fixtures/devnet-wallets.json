{
  "cluster": "devnet",
  "programId": "41P2wHKAr69aSgLgt1QdKH6VVgK6uFYKM7hpKAyBxr9j",
  "usdcMint": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",
  "depositMicroUsdc": 5000000,
  "pdaSeed": "agent_payment_stream",
  "vaultSeed": "universal_vault",
  "wallets": {
    "user": {
      "role": "client / stream owner",
      "env": "KS_USER_WALLET",
      "defaultPath": "~/.config/solana/id.json"
