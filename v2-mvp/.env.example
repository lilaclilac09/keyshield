# ── KeyShield v2 环境变量 ──────────────────────────────────────────────────────

# 服务配置
PORT=8000

# Session 加密密钥（至少 32 字符，随机生成：python -c "import secrets; print(secrets.token_hex(32))"）
SERVER_SECRET=CHANGE-ME-IN-PROD-USE-python-secrets-token-hex-32

# ── 平台 key（User B 使用，按量收费）────────────────────────────────────────────
# 如果只做 User A（用户存自己的 key），可以不填

HELIUS_API_KEY=
OPENAI_API_KEY=

# ── 测试用 ──────────────────────────────────────────────────────────────────────
# 填入真实 key 才会跑真实代理测试
TEST_HELIUS_KEY=
