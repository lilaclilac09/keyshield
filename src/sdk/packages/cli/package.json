{
  "name": "@keyshield/cli",
  "version": "0.1.0",
  "private": true,
  "description": "KeyShield CLI — consume the popup-exported .env file and inject API keys into agent processes. Mirrors `op run` / `1password-cli` semantics.",
  "type": "module",
  "bin": {
    "keyshield": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.4.5",
    "vitest": "^2.1.9"
  }
}
