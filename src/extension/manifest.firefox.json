{
  "manifest_version": 3,
  "name": "KeyShield — Device Vault",
  "version": "2.0.0",
  "description": "Save one selected or pasted key, encrypted on this device.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://platform.openai.com/*",
    "https://console.anthropic.com/*",
    "https://dashboard.stripe.com/*",
    "https://github.com/*",
    "https://console.aws.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyShield device vault"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "keyshield@aileena.xyz",
      "strict_min_version": "128.0"
    }
  }
}
