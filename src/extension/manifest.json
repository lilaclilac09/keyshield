{
  "manifest_version": 3,
  "name": "KeyShield — Device Vault",
  "version": "2.0.0",
  "description": "Find keys only on request; save encrypted on this device.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://platform.openai.com/*",
    "https://console.anthropic.com/*",
    "https://dashboard.stripe.com/*",
    "https://github.com/*",
    "https://console.aws.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyShield device vault"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
