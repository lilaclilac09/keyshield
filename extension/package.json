{
  "name": "keyshield-extension",
  "version": "1.0.0",
  "description": "KeyShield Browser Extension",
  "scripts": {
    "build": "webpack --mode production && npm run copy-assets",
    "build:dev": "webpack --mode development && npm run copy-assets",
    "build:chrome": "npm run build",
    "build:firefox": "npm run build",
    "build:all": "./build-all.sh",
    "copy-assets": "mkdir -p dist/icons && cp -r src/icons/* dist/icons/ 2>/dev/null || true && cp manifest.json dist/ 2>/dev/null || true",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf dist dist-chrome dist-firefox dist-safari",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@lit-protocol/lit-node-client": "^4.0.0",
    "@lit-protocol/constants": "^4.0.0",
    "@lit-protocol/types": "^4.0.0",
    "tesseract.js": "^5.0.0",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.251",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.4.4"
  }
}
