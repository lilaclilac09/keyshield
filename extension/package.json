{
  "name": "@keyshield/extension",
  "version": "2.0.0",
  "description": "KeyShield Agentic - Universal API Key Vault Browser Extension",
  "scripts": {
    "dev": "plasmoid dev",
    "build": "plasmoid build",
    "build:chrome": "plasmoid build --target chrome",
    "build:firefox": "plasmoid build --target firefox",
    "package": "plasmoid package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@lit-protocol/lit-node-client": "^7.4.0",
    "@lit-protocol/constants": "^9.0.1",
    "@lit-protocol/auth-helpers": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.462.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.251",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@keyshield/agent-sdk": "*",
    "typescript": "~5.4.5",
    "tailwindcss": "^3.4.3",
