# KeyShield — copy to `.env` and fill values you actually use.
# `docker compose --env-file .env up -d` reads this.

# ─── core auth (REQUIRED) ───────────────────────────────────────────
SERVER_SECRET=change-me-to-a-32+-byte-random-string                 # python
KS_INTERNAL_SECRET=change-me-internal-firewall                       # python ↔ rust-proxy

# ─── databases (compose defaults are fine) ──────────────────────────
DATABASE_URL=postgresql://keyshield:keyshield@postgres:5432/keyshield   # python
REDIS_URL=redis://redis:6379/0                                          # python

# ─── Solana on-chain ────────────────────────────────────────────────
KS_KEYSHIELD_PROGRAM_ID=41P2wHKAr69aSgLgt1QdKH6VVgK6uFYKM7hpKAyBxr9j  # python (devnet)
KS_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU             # python (devnet USDC)
KS_MPP_SETTLER_PUBKEY=                                                 # python — your settler wallet pubkey (base58)
KS_MPP_SETTLER_KEY=                                                    # python — settler keypair, 64-byte ed25519 base58 (KEEP SECRET)
KS_PLATFORM_USDC_ATA=                                                  # python — settler's USDC ATA pubkey
KS_SOLANA_RPC_URL=https://api.devnet.solana.com                       # python

# ─── Stage 4 live e2e (scripts/live_e2e_run.ts) ─────────────────────
# LIVE_E2E=1                 # unset = dry-run
# KS_LIVE_PROVIDER=openrouter  # openrouter | ollama | vllm
# KS_LIVE_MODEL=meta-llama/llama-3.2-3b-instruct:free
# KS_USER_WALLET=~/.config/solana/id.json
# KS_PROVIDER_WALLET=.keyshield-devnet/mpp-settler-devnet.json
# OPENROUTER_API_KEY=
# KS_OPENROUTER_BASE=https://openrouter.ai
# KS_OLLAMA_BASE=http://127.0.0.1:11434
# KS_VLLM_BASE=http://127.0.0.1:8000

# ─── x402 receivers ─────────────────────────────────────────────────
KS_X402_BASE_RPC_URL=https://mainnet.base.org                         # python
KS_X402_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000   # python — your Base USDC receiver
KS_X402_VERIFY_REQUIRED=0                                              # python — set 1 to refuse stub-mode

# ─── Helius (typed Rust client lives in src/proxy/crates/ks-helius) ─
HELIUS_API_KEY=                                                        # rust-proxy + python (used when proxying /helius/*)

# ─── frontend build-time (passed as Docker build args) ──────────────
KEYSHIELD_API_URL=http://localhost:8000                                # web-v2
KEYSHIELD_PROGRAM_ID=41P2wHKAr69aSgLgt1QdKH6VVgK6uFYKM7hpKAyBxr9j     # web-v2
KEYSHIELD_SOLANA_CLUSTER=devnet                                        # web-v2 (devnet|testnet|mainnet-beta)
KEYSHIELD_SYNC_URL=http://localhost:8787                               # web-v2 — Path A vault sync (CF Worker)

# ─── observability (only used with --profile observability) ─────────
GF_SECURITY_ADMIN_PASSWORD=admin                                       # grafana
