{
  "name": "@keyshield/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./lib/*": {
      "import": "./src/lib/*.ts"
    },
    "./auth": {
      "import": "./src/auth/index.ts"
    },
    "./auth/*": {
      "import": "./src/auth/*.ts"
    },
    "./hooks/*": {
      "import": "./src/hooks/*.ts"
    },
    "./stores": {
      "import": "./src/stores/index.ts"
    },
    "./stores/*": {
      "import": "./src/stores/*.ts"
    },
    "./types": {
      "import": "./src/types/index.ts"
    },
    "./types/*": {
      "import": "./src/types/*.ts"
    },
    "./api": {
      "import": "./src/api/index.ts"
    }
  },
  "dependencies": {
    "zod": "^3.24.0",
    "@tanstack/react-query": "^5.66.0",
    "zustand": "^5.0.0",
    "@solana/web3.js": "^2.0.0",
    "tesseract.js": "^6.0.0",
    "@simplewebauthn/browser": "^11.0.0"
  },
  "devDependencies": {
    "@keyshield/tsconfig": "file:../../tooling/typescript-config",
    "typescript": "^5.7.0"
  }
}
