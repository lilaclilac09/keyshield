# =============================================================================
# KeyShield .gitignore — Cross-platform SOTA Architecture
# =============================================================================

# --- Dependencies -----------------------------------------------------------
node_modules/
**/node_modules/

# --- Build outputs -----------------------------------------------------------
/dist/
/build/
/out/
.next/
src/web/dist/
src/proxy/target/
src/programs/*/target/
src/mobile/dist/
src/infra/metrics-ui/dist/
src/web-v2/dist/
src/web-v2/tsconfig.tsbuildinfo
*.egg-info/
*.dll
*.exe
*.so
*.dylib

# --- IDE & OS ---------------------------------------------------------------
.DS_Store
*.swp
*.swo
.vscode/
.idea/
.cursor/
*.pem
*.log

# --- Environment & Secrets -----------------------------------------------
.env*
!.env.example
.keyshield-vault.json
*.json.key

# --- Python cache -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Python virtualenvs (NEVER commit — v2-mvp/.venv was a 162-file mistake) -
.venv/
**/.venv/
venv/
**/venv/

# --- Rust artifacts ----------------------------------------------------------
**/*.rs.bk
Cargo.lock.lock
*.pdb
target/

# --- Model files (too large for git) ---------------------------------------
*.gguf
*.bin
*.safetensors
/models/

# --- GitNexus ---------------------------------------------------------------
.gitnexus/

# --- Temporary -----------------------------------------------------------------
*.rar
*.zip
disk.txt
sizes.txt
debug.log

# --- Test artifacts ---------------------------------------------------------
coverage/
.pytest_cache/
test-results/
test-ledger/

# --- Claude Code ------------------------------------------------------------
.claude/worktrees/
.dropped-*/

# --- Runtime data (DBs, vaults, etc) ---------------------------------------
src/backend/data/*.db
src/backend/sessions.db
src/backend/vault/
*.enc
.keyshield-demo/
keyshield.db
*.db-shm
*.db-wal
.gstack/

# MPP devnet — settler keypair + env (NEVER commit)
.env.mpp
.keyshield-devnet/
src/.keyshield-devnet/
.vercel
