# =============================================================================
# KeyShield .gitignore — Cross-platform SOTA Architecture
# =============================================================================

# --- Dependencies -----------------------------------------------------------
node_modules/
**/node_modules/

# --- Build outputs -----------------------------------------------------------
src/ios/DerivedData/
src/ios/build/
**/xcuserdata/
/dist/
/build/
/out/
.next/
src/web/dist/
src/desktop/renderer/
src/desktop/out/
src/desktop/release/
src/desktop/icon.png
src/proxy/target/
src/programs/*/target/
src/mobile/dist/
src/infra/metrics-ui/dist/
src/web-v2/dist/
src/web-v2/tsconfig.tsbuildinfo
*.egg-info/
*.dll
*.exe
*.so
*.dylib

# --- IDE & OS ---------------------------------------------------------------
.DS_Store
*.swp
*.swo
.vscode/
.idea/
.cursor/
*.pem
*.log

# --- Environment & Secrets -----------------------------------------------
.env*
!.env.example
.keyshield-vault.json
*.json.key

# --- Python cache -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Python virtualenvs (NEVER commit — v2-mvp/.venv was a 162-file mistake) -
.venv/
**/.venv/
venv/
**/venv/

# --- Rust artifacts ----------------------------------------------------------
**/*.rs.bk
Cargo.lock.lock
*.pdb
target/

# --- Model files (too large for git) ---------------------------------------
*.gguf
*.bin
*.safetensors
/models/

# --- GitNexus ---------------------------------------------------------------
.gitnexus/

# --- Temporary -----------------------------------------------------------------
*.rar
*.zip
disk.txt
sizes.txt
debug.log

# --- Test artifacts ---------------------------------------------------------
coverage/
.pytest_cache/
test-results/
test-ledger/

# --- Claude Code ------------------------------------------------------------
.claude/worktrees/
.dropped-*/

# --- Runtime data (DBs, vaults, etc) ---------------------------------------
src/backend/data/*.db
src/backend/sessions.db
src/backend/vault/
*.enc
.keyshield-demo/
keyshield.db
*.db-shm
*.db-wal
.gstack/

# MPP devnet — settler keypair + env (NEVER commit)
.env.mpp
.keyshield-devnet/
src/.keyshield-devnet/
.vercel

# Cloudflare Wrangler local dev/cache (never commit)
**/.wrangler/
src/demo-next/tsconfig.tsbuildinfo

# Secrets — NEVER commit (added 2026-11-23)
# Block .env, keys, keypairs, and wallets. Do not commit secrets.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.keystore
*.jks
wallet.json
**/wallet.json
id.json
**/id.json
keypair.json
*-keypair.json
*.keypair.json
*.keypair
authority.json
secrets.json
credentials.json
service-account*.json
.secret
secrets/
*.wallet
