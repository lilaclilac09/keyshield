# =============================================================================
# KeyShield .gitignore — SOTA Architecture
# =============================================================================

# --- Dependencies -----------------------------------------------------------
# Universal: ignore node_modules anywhere in the tree, regardless of layout.
# Replaces the per-path enumeration (web-frontend / mobile-app / api-server /
# sdk/*) that missed legacy locations (mobile/, packages/cli/, frontend/,
# server/, extension-sync/, infra/sync-worker/, .dropped-*/) and tracked
# 189k node_modules files in git as a result.
node_modules/

# --- Build outputs -----------------------------------------------------------
/dist
/build
/out
/.next/
/src/web-frontend/.next/
/src/rust-proxy/target/
/src/python-legacy/build*/
/src/python-legacy/*.egg-info/
/src/python-legacy/TurboQuant/

# --- IDE & OS ---------------------------------------------------------------
.DS_Store
*.swp
*.swo
.vscode/
.idea/
*.pem
*.log

# --- Environment & Secrets -----------------------------------------------
.env*
!.env.example
.keyshield-vault.json
*.json.key

# --- Python cache -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Rust artifacts ----------------------------------------------------------
**/*.rs.bk
Cargo.lock.lock
*.pdb

# --- Model files (too large for git) ---------------------------------------
*.gguf
*.bin
*.safetensors
/models/

# --- GitNexus ---------------------------------------------------------------
.gitnexus/

# --- Temporary -----------------------------------------------------------------
*.rar
*.zip
disk.txt
sizes.txt
debug.log

# --- Test artifacts ---------------------------------------------------------
coverage/
.pytest_cache/
