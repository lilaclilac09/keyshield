# Rust build artifacts
target/
**/*.rs.bk
Cargo.lock

# OS files
.DS_Store
*.swp
*.swo
*~

# Environment files
.env
.env.*
.env.local
.env*.local

# IDE
.vscode/
.idea/
*.iml
.cursor/

# Claude Code / agent session artifacts (worktrees, settings, backups)
# `.claude/` is kept tracked (project conventions live there); only the
# session-local subpaths and ad-hoc dump dirs are ignored.
.claude/worktrees/
.claude/settings.local.json
.dropped-*
.openclaw/
.keyshield-demo/
.gbrain/
.aget/

# Node modules (if not already ignored)
node_modules/
**/node_modules/
frontend/node_modules/
extension/node_modules/

# Next.js build outputs
.next/
**/.next/
frontend/.next/
frontend/.next/cache/

# Build outputs
dist/
build/
*.so

# 测试数据库和日志文件（自动忽略大文件）
test-ledger/
*.log
rocksdb/
0000*.log
**/*.log
.gstack/

# Python build artifacts (stops `pytest` from leaving untracked files)
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/
*.egg-info/
