# =============================================================================
# KeyShield .gitignore — SOTA Architecture
# =============================================================================

# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Build outputs -----------------------------------------------------------
/dist
/build
/out
/.next/
/src/web-frontend/.next/
/src/rust-proxy/target/
/target/
/src/python-legacy/build*/
/src/python-legacy/*.egg-info/
/src/python-legacy/TurboQuant/

# --- IDE & OS ---------------------------------------------------------------
.DS_Store
*.swp
*.swo
.vscode/
.idea/
*.pem
*.log

# --- Environment & Secrets -----------------------------------------------
.env*
!.env.example
.keyshield-vault.json
*.json.key

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.venv/
.venv/
v2-mvp/.pytest_cache/
src/python-legacy/.pytest_cache/
v2-mvp/src/__pycache__/
src/python-legacy/src/__pycache__/
v2-mvp/sessions.db
v2-mvp/keyshield.db
v2-mvp/src/sessions.db
v2-mvp/src/keyshield.db

# --- Rust -------------------------------------------------------------------
*.rs.bk
*.rs.orig
*.d
*.o
target/
proxy-rs/target/

# --- Model files (too large for git) ---------------------------------------
*.gguf
*.bin
*.safetensors
/models/

# --- GitNexus ---------------------------------------------------------------
.gitnexus/

# --- Compiled data files ----------------------------------------------------
*.enc
*.db
*.sqlite
*/data/*.db
*/vault/dt/
*/wallet/*.json
src/api-server/src/vault/test-vault-user/
v2-mvp/vault/bench_user/
v2-mvp/vault/user_*/

# --- Generated data ---------------------------------------------------------
src/api-server/src/data/
src/api-server/src/wallet/
v2-mvp/data/
src/python-legacy/data/*.db
src/python-legacy/sessions.db

# --- Temporary ----------------------------------------------------------------
*.rar
*.zip
disk.txt
sizes.txt
debug.log

# --- Test artifacts ---------------------------------------------------------
coverage/
.coverage

# --- Claude Code ------------------------------------------------------------
.claude/worktrees/
.dropped-*/
