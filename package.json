{
  "name": "keyshield",
  "private": true,
  "workspaces": [
    "packages/shared",
    "src/sdk/packages/agent-sdk",
    "src/sdk/packages/cli",
    "src/sdk/packages/goat-wallet",
    "src/infra/sync-worker",
    "src/web"
  ],
  "scripts": {
    "dev:web": "cd src/web && npm run dev",
    "dev:worker": "npm run dev --workspace=@keyshield/sync-worker",
    "dev:api": "python3 -m uvicorn src.backend.app:app --host 127.0.0.1 --port 8001 --log-level info",
    "build:web": "cd src/web && npm run build",
    "demo": "bash src/scripts/demo.sh",
    "gitnexus": "node src/scripts/gitnexus.cjs",
    "docs:pitch-pdf": "marp docs/pitch/PITCH_DECK.md --allow-local-files -o docs/pitch/PITCH_DECK.pdf",
    "test": "npm run test --workspaces --if-present",
    "test:scvd": "vitest run tests/scvd_dom_intent.test.ts tests/scvd_prf_lifecycle.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@solana/web3.js": "^1.98.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^6.2.0"
  }
}