{
  "name": "keyshield",
  "private": true,
  "workspaces": [
    "packages/*",
    "extension",
    "extension-sync",
    "infra/sync-worker",
    "mobile"
  ],
  "scripts": {
    "dev:popup": "npm run dev --workspace=@keyshield/extension-sync",
    "dev:worker": "npm run dev --workspace=@keyshield/sync-worker",
    "demo": "bash demo.sh",
    "docs:pitch-pdf": "marp docs/pitch/PITCH_DECK.md --allow-local-files -o docs/pitch/PITCH_DECK.pdf",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
