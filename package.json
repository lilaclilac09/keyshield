{
  "name": "keyshield",
  "private": true,
  "workspaces": [
     "src/sdk/packages/agent-sdk",
     "src/sdk/packages/cli",
     "src/sdk/packages/goat-wallet",
     "src/infra/sync-worker",
     "src/web-v2"
   ],
  "scripts": {
    "dev": "npm run dev --workspace=keyshield-web-v2",
    "dev:web": "cd src/web && npm run dev",
    "dev:worker": "npm run dev --workspace=@keyshield/sync-worker",
    "build": "npm run build --workspace=keyshield-web-v2",
    "build:web": "cd src/web && npm run build",
    "preview": "npm run preview --workspace=keyshield-web-v2",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "demo": "bash src/scripts/demo.sh",
    "docs:pitch-pdf": "marp docs/pitch/PITCH_DECK.md --allow-local-files -o docs/pitch/PITCH_DECK.pdf",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.157.0",
    "globals": "^16.3.0",
    "typescript": "^5.6.3",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^2.1.9",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
     "@noble/hashes": "^2.2.0",
     "react": "^19.2.3",
     "react-dom": "^19.2.3"
   }
}
