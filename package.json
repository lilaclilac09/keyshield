{
  "name": "keyshield",
  "private": true,
  "workspaces": [
     "src/sdk/packages/agent-sdk",
     "src/sdk/packages/cli",
     "src/sdk/packages/goat-wallet",
     "infra/sync-worker",
     "src/mobile-app"
   ],
  "scripts": {
    "dev": "cd \"frontend\" && npm run dev",
    "dev:worker": "npm run dev --workspace=@keyshield/sync-worker",
    "demo": "bash demo.sh",
    "docs:pitch-pdf": "marp docs/pitch/PITCH_DECK.md --allow-local-files -o docs/pitch/PITCH_DECK.pdf",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@solana/web3.js": "^1.98.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
