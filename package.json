{
  "name": "keyshield",
  "private": true,
  "workspaces": [
    "packages/shared",
    "src/sdk/packages/agent-sdk",
    "src/sdk/packages/cli",
    "src/sdk/packages/goat-wallet",
    "src/infra/sync-worker",
    "src/web"
  ],
  "scripts": {
    "dev:web": "cd src/web && npm run dev",
    "dev:demo-next": "cd src/demo-next && npm run dev",
    "dev:worker": "npm run dev --workspace=@keyshield/sync-worker",
    "dev:api": "python3 -m uvicorn src.backend.app:app --host 127.0.0.1 --port 8001 --log-level info",
    "build:web": "cd src/web && npm run build",
    "demo": "bash src/scripts/demo.sh",
    "docs:pitch-pdf": "marp docs/pitch/PITCH_DECK.md --allow-local-files -o docs/pitch/PITCH_DECK.pdf",
    "test": "npm run test --workspaces --if-present",
    "test:bankrun": "vitest run tests/bankrun_security.test.ts",
    "test:fault": "vitest run tests/proxy_fault_injection.test.ts",
    "test:invariants": "cargo test -p keyshield --lib --test bankrun_invariants --test fuzz_invariants --test embedded_wallet_layout -- --test-threads=1",
    "test:harness": "npm run test:bankrun && npm run test:fault && npm run live:e2e:dry",
    "live:e2e": "npx --yes tsx scripts/live_e2e_run.ts",
    "live:e2e:dry": "npx --yes tsx scripts/live_e2e_run.ts --dry-run",
    "live:e2e:setup": "npx --yes tsx scripts/live_e2e_setup.ts",
    "live:zk-vault": "npx --yes tsx scripts/run_devnet_zk_vault.ts",
    "live:zk-vault:fallback": "KS_ZK_ALLOW_FALLBACK=1 npx --yes tsx scripts/run_devnet_zk_vault.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@solana/web3.js": "^1.98.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^6.2.0"
  }
}