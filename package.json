{
  "name": "keyshield",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd \"frontend\" && npm run dev",
    "demo": "bash demo.sh",
    "docs:pitch-pdf": "marp docs/pitch/PITCH_DECK.md --allow-local-files -o docs/pitch/PITCH_DECK.pdf",
    "test": "npm run test --workspaces --if-present",
